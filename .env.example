# ======================================================================
# إعدادات منظومة أساس للوكيل البرمجي (ASAAS Vibe-Coded Content Agent)
# انسخ هذا الملف إلى .env وضع مفتاحك (أو أدخل المفتاح مباشرة من واجهة الموقع)
# ======================================================================

# مزود نماذج الذكاء الاصطناعي (أي مزود متوافق مع OpenAI Chat Completions)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODELS=["google/gemini-2.5-flash","nvidia/nemotron-3-ultra-550b-a55b:free"]
LLM_TIMEOUT_SECONDS=45

# منافذ التشغيل
BACKEND_PORT=8085
FRONTEND_PORT=5180

# قاعدة بيانات SQLite المحلية (الافتراضي: backend/data/app.db)
# DATABASE_PATH=./backend/data/app.db

# ضوابط وسياج الوكيل (ASAAS AI Skills Guardrails)
AGENT_MAX_ITERATIONS=2
AGENT_QUALITY_THRESHOLD=8
AGENT_MAX_TOKENS=1200
AGENT_RATE_LIMIT_PER_HOUR=60
