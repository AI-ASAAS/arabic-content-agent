# ========================================================
# إعدادات بيئة العمل لمنظومة n8n
# ========================================================

# منفذ تشغيل خادم n8n
N8N_PORT=5678

# الرابط الأساسي لخادم n8n
N8N_BASE_URL=http://localhost:5678

# مفتاح API الخاص بـ n8n (اختياري - يتم إنشاؤه من Settings -> API في n8n)
N8N_API_KEY=

# المنطقة الزمنية
GENERIC_TIMEZONE=Asia/Riyadh
TZ=Asia/Riyadh
