        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=قم بإجراء التنقيح النهائي على المنشورات الثلاثة بناءً على النقد الثاني:\n{{ $json.text }}"
      }
    },
    {
      "id": "node-12-code-js",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        300
      ],
      "parameters": {
        "jsCode": "// Format output posts cleanly\nconst rawText = $json.text || '';\nreturn [{\n  json: {\n    status: 'completed',\n    workflow_type: 'Sequential Baseline (13 Nodes)',\n    final_arabic_content: rawText,\n    processed_at: new Date().toISOString()\n  }\n}];"
      }
