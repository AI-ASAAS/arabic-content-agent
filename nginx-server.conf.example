# ======================================================================
# نموذج إعداد Nginx لسيرفرات الإنتاج (ASAAS Vibe-Coded Agent + Frontend)
# انسخ هذا الملف إلى /etc/nginx/sites-available/asaas-agent
# ثم فعله عبر: sudo ln -s /etc/nginx/sites-available/asaas-agent /etc/nginx/sites-enabled/
# ======================================================================

server {
    listen 80;
    server_name your-domain.com; # ضع اسم نطاقك هنا (أو IP السيرفر)

    # توجيه طلبات API والبث المباشر SSE إلى خادم الوكيل FastAPI
    location /api/ {
        proxy_pass http://127.0.0.1:8085/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # تعطيل التخزين المؤقت لضمان تدفق البث المباشر SSE لحظياً
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 300;
    }

    # الواجهة الأمامية التفاعلية (Asaas UI)
    location / {
        proxy_pass http://127.0.0.1:5180;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
